# Required: the GitHub user this portfolio renders.
GITHUB_USERNAME=octocat

# Optional: personal access token (no scopes needed for public data).
# Raises the rate limit from 60 to 5000 requests/hour and enables ETag reuse.
GITHUB_TOKEN=

# Port the HTTP server listens on (container maps it to ${PORT}).
PORT=8080

# How often the background task re-polls the GitHub API (seconds, min 15).
REFRESH_INTERVAL_SECS=300

# Shared secret for POST /api/refresh. Leave empty to disable the endpoint.
ADMIN_TOKEN=change-me

# Comma-separated repo names shown first on the site.
PINNED_REPOS=dotfiles,my-blog

# Comma-separated repo names that are never shown.
EXCLUDED_REPOS=old-prototype,private-notes

# Include forks / archived repositories (0 or 1).
SHOW_FORKS=0
SHOW_ARCHIVED=0

# Where the JSON snapshot is persisted (Docker overrides this with /data).
CACHE_DIR=./data

# Log verbosity for the app (RUST_LOG), e.g. info, debug.
RUST_LOG=gh_portfolio=info,tower_http=info
