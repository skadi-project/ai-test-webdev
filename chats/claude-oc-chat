                "text": "[package]\r\nname = \"github-portfolio\"\r\nversion = \"0.1.0\"\r\nedition = \"2021\"\r\ndescription = \"SSR GitHub portfolio built with Axum\"\r\nlicense = \"MIT\"\r\n\r\n[dependencies]\r\naxum = \"0.7\"\r\ntokio = { version = \"1\", features = [\"full\"] }\r\nreqwest = { version = \"0.12\", default-features = false, features = [\"json\", \"rustls-tls\"] }\r\nserde = { version = \"1\", features = [\"derive\"] }\r\nserde_json = \"1\"\r\naskama = \"0.12\"\r\nchrono = { version = \"0.4\", features = [\"serde\", \"clock\"] }\r\ntower-http = { version = \"0.5\", features = [\"trace\", \"fs\"] }\r\ntracing = \"0.1\"\r\ntracing-subscriber = { version = \"0.3\", features = [\"env-filter\"] }\r\nthiserror = \"1\"\r\n\r\n[dev-dependencies]\r\nhttp-body-util = \"0.1\"\r\nuse axum::{\r\n    extract::{Query, State},\r\n    http::StatusCode,\r\n    response::{Html, IntoResponse, Redirect},\r\n    routing::{get, post},\r\n    Form, Router,\r\n};\r\nuse chrono::{DateTime, Utc};\r\nuse serde::{Deserialize, Serialize};\r\nuse std::{\r\n    cmp::Reverse,\r\n    env,\r\n    sync::Arc,\r\n    time::{Duration, Instant},\r\n};\r\nuse tokio::sync::RwLock;\r\nuse tower_http::trace::TraceLayer;\r\nuse tracing::{error, info};\r\n\r\n#[derive(Clone, Debug, Serialize, Deserialize)]\r\npub struct Repo {\r\n    pub name: String,\r\n    pub description: Option<String>,\r\n    pub html_url: String,\r\n    pub stargazers_count: u64,\r\n    pub forks_count: u64,\r\n    pub language: Option<String>,\r\n    pub updated_at: DateTime<Utc>,\r\n    pub topics: Vec<String>,\r\n}\r\n\r\n#[derive(Clone)]\r\nstruct Cache {\r\n    repos: Arc<RwLock<Vec<Repo>>>,\r\n    updated: Arc<RwLock<Option<Instant>>>,\r\n    ttl: Duration,\r\n}\r\n#[derive(Clone)]\r\nstruct AppState {\r\n    username: String,\r\n    cache: Cache,\r\n    client: reqwest::Client,\r\n}\r\n#[derive(Deserialize, Default)]\r\nstruct Filters {\r\n    q: Option<String>,\r\n    language: Option<String>,\r\n    sort: Option<String>,\r\n}\r\n#[derive(Deserialize)]\r\nstruct Refresh {\r\n    _refresh: Option<String>,\r\n}\r\n\r\nasync fn fetch_repos(state: &AppState) -> Result<Vec<Repo>, String> {\r\n    let url = format!(\r\n        \"https://api.github.com/users/{}/repos?per_page=100&sort=updated\",\r\n        state.username\r\n    );\r\n    state\r\n        .client\r\n        .get(url)\r\n        .header(\"User-Agent\", \"github-portfolio\")\r\n        .send()\r\n        .await\r\n        .map_err(|e| e.to_string())?\r\n        .error_for_status()\r\n        .map_err(|e| e.to_string())?\r\n        .json()\r\n        .await\r\n        .map_err(|e| e.to_string())\r\n}\r\nasync fn cached(state: &AppState, force: bool) -> Result<Vec<Repo>, String> {\r\n    let fresh = !force\r\n        && state\r\n            .cache\r\n            .updated\r\n            .read()\r\n            .await\r\n            .map(|x| x.elapsed() < state.cache.ttl)\r\n            .unwrap_or(false);\r\n    if fresh {\r\n        return Ok(state.cache.repos.read().await.clone());\r\n    }\r\n    let repos = fetch_repos(state).await?;\r\n    *state.cache.repos.write().await = repos.clone();\r\n    *state.cache.updated.write().await = Some(Instant::now());\r\n    Ok(repos)\r\n}\r\nfn render(repos: Vec<Repo>, username: &str, filters: &Filters, stale: bool) -> String {\r\n    let q = filters.q.as_deref().unwrap_or(\"\").to_lowercase();\r\n    let lang = filters.language.as_deref().unwrap_or(\"\");\r\n    let mut items: Vec<_> = repos\r\n        .iter()\r\n        .filter(|r| {\r\n            (q.is_empty()\r\n                || r.name.to_lowercase().contains(&q)\r\n                || r.description\r\n                    .clone()\r\n                    .unwrap_or_default()\r\n                    .to_lowercase()\r\n                    .contains(&q))\r\n                && (lang.is_empty() || r.language.as_deref() == Some(lang))\r\n        })\r\n        .cloned()\r\n        .collect();\r\n    match filters.sort.as_deref() {\r\n        Some(\"stars\") => items.sort_by_key(|r| Reverse(r.stargazers_count)),\r\n        Some(\"forks\") => items.sort_by_key(|r| Reverse(r.forks_count)),\r\n        _ => items.sort_by_key(|r| Reverse(r.updated_at)),\r\n    }\r\n    let langs: Vec<String> = {\r\n        let mut x: Vec<_> = repos.iter().filter_map(|r| r.language.clone()).collect();\r\n        x.sort();\r\n        x.dedup();\r\n        x\r\n    };\r\n    let cards = items.iter().map(|r| format!(r#\"<article class=\"card\"><div class=\"card-head\"><h2><a href=\"{}\">{}</a></h2><span class=\"lang\">{}</span></div><p>{}</p><footer>�?: {} &nbsp;�'' {} &nbsp; <small>updated {}</small></footer></article>\"#, esc(&r.html_url), esc(&r.name), esc(r.language.as_deref().unwrap_or(\"Other\")), esc(r.description.as_deref().unwrap_or(\"No description\")), r.stargazers_count, r.forks_count, r.updated_at.format(\"%Y-%m-%d\"))).collect::<String>();\r\n    let options = langs\r\n        .iter()\r\n        .map(|l| {\r\n            format!(\r\n                r#\"<option {}>{}</option>\"#,\r\n                if lang == l { \"selected\" } else { \"\" },\r\n                esc(l)\r\n            )\r\n        })\r\n        .collect::<String>();\r\n    format!(\r\n        r##\"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><title>{username} �� GitHub portfolio</title><style>{CSS}</style></head><body><main><header><p class=\"eyebrow\">GITHUB PORTFOLIO</p><h1>{username}<span>.</span></h1><p class=\"intro\">A curated collection of open-source work and experiments.</p><form method=\"get\"><input name=\"q\" value=\"{}\" placeholder=\"Search repositories�?�\"><select name=\"language\"><option value=\"\">All languages</option>{}</select><select name=\"sort\"><option value=\"updated\">Recently updated</option><option value=\"stars\" {}>Most stars</option><option value=\"forks\" {}>Most forks</option></select><button>Filter</button></form></header>{}<div class=\"meta\">{} repositories �� {} </div><section class=\"grid\">{}</section><form method=\"post\" action=\"/refresh\"><button class=\"refresh\">��> Refresh cache</button></form></main></body></html>\"##,\r\n        esc(filters.q.as_deref().unwrap_or(\"\")),\r\n        options,\r\n        if filters.sort.as_deref() == Some(\"stars\") {\r\n            \"selected\"\r\n        } else {\r\n            \"\"\r\n        },\r\n        if filters.sort.as_deref() == Some(\"forks\") {\r\n            \"selected\"\r\n        } else {\r\n            \"\"\r\n        },\r\n        if stale {\r\n            \"<p class=\\\"notice\\\">Live data unavailable; showing cached data.</p>\"\r\n        } else {\r\n            \"\"\r\n        },\r\n        items.len(),\r\n        if stale { \"cached\" } else { \"live\" },\r\n        cards\r\n    )\r\n}\r\nfn esc(s: &str) -> String {\r\n    s.replace('&', \"&amp;\")\r\n        .replace('<', \"&lt;\")\r\n        .replace('>', \"&gt;\")\r\n        .replace('\"', \"&quot;\")\r\n}\r\nconst CSS: &str = include_str!(\"../static/style.css\");\r\nasync fn index(State(s): State<AppState>, Query(f): Query<Filters>) -> Html<String> {\r\n    let data = cached(&s, false).await;\r\n    let stale = data.is_err();\r\n    let repos = match data {\r\n        Ok(repos) => repos,\r\n        Err(_) => s.cache.repos.read().await.clone(),\r\n    };\r\n    Html(render(repos, &s.username, &f, stale))\r\n}\r\nasync fn refresh(State(s): State<AppState>, Form(_): Form<Refresh>) -> impl IntoResponse {\r\n    match cached(&s, true).await {\r\n        Ok(_) => Redirect::to(\"/\").into_response(),\r\n        Err(e) => {\r\n            error!(%e, \"refresh failed\");\r\n            (StatusCode::BAD_GATEWAY, \"GitHub API unavailable\").into_response()\r\n        }\r\n    }\r\n}\r\n#[tokio::main]\r\nasync fn main() {\r\n    tracing_subscriber::fmt().with_env_filter(\"info\").init();\r\n    let username = env::var(\"GITHUB_USERNAME\").unwrap_or_else(|_| \"octocat\".into());\r\n    let state = AppState {\r\n        username,\r\n        cache: Cache {\r\n            repos: Arc::new(RwLock::new(vec![])),\r\n            updated: Arc::new(RwLock::new(None)),\r\n            ttl: Duration::from_secs(\r\n                env::var(\"CACHE_TTL\")\r\n                    .ok()\r\n                    .and_then(|x| x.parse().ok())\r\n                    .unwrap_or(900),\r\n            ),\r\n        },\r\n        client: reqwest::Client::new(),\r\n    };\r\n    let app = Router::new()\r\n        .route(\"/\", get(index))\r\n        .route(\"/refresh\", post(refresh))\r\n        .with_state(state)\r\n        .layer(TraceLayer::new_for_http());\r\n    let addr = \"0.0.0.0:3000\";\r\n    info!(%addr,\"listening\");\r\n    let listener = tokio::net::TcpListener::bind(addr).await.unwrap();\r\n    axum::serve(listener, app).await.unwrap();\r\n}\r\n#[cfg(test)]\r\nmod tests {\r\n    use super::*;\r\n    #[test]\r\n    fn escapes_html() {\r\n        assert_eq!(esc(\"<x> & \\\"\"), \"&lt;x&gt; &amp; &quot;\");\r\n    }\r\n}\r\n# GitHub Portfolio\r\n\r\nA finished, responsive server-side rendered GitHub portfolio built with Rust, Axum and Askama-style HTML rendering. It fetches public repositories, caches them in memory, supports manual refresh, filtering and sorting, and runs in Docker.\r\n\r\n## Run\r\n\r\n```bash\r\nGITHUB_USERNAME=torvalds cargo run\r\n# open http://localhost:3000\r\n```\r\n\r\nEnvironment variables:\r\n- `GITHUB_USERNAME` �?\" GitHub login (default: `octocat`)\r\n- `CACHE_TTL` �?\" cache lifetime in seconds (default: `900`)\r\n- `RUST_LOG` �?\" tracing filter\r\n\r\n## Docker\r\n\r\n```bash\r\ndocker build -t github-portfolio .\r\ndocker run --rm -p 3000:3000 -e GITHUB_USERNAME=torvalds github-portfolio\r\n```\r\n\r\n## Features\r\n\r\n- SSR HTML with no JavaScript requirement\r\n- GitHub API integration with User-Agent and graceful stale-cache fallback\r\n- Search by name/description, language filter, sorting by update/stars/forks\r\n- Responsive dark UI and e