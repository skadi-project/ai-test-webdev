   let profile_etag = previous_snapshot\n        .as_ref()\n        .and_then(|snapshot| snapshot.etag_profile.clone());\n    let profile_result = github.user(profile_etag.as_deref()).await?;\n    let (profile, etag_profile) = resolve(\n        profile_result,\n        previous_snapshot\n            .as_ref()\n            .map(|snapshot| snapshot.profile.clone()),\n        profile_etag,\n    )?\n    .ok_or_else(|| {\n        GitHubError::Decode(\"GitHub returned 304 without a cached profile\".to_owned())\n    })?;\n\n    // --- repositories ------------------------------------------------------\n    let repos_etag = previous_snapshot\n        .as_ref()\n        .and_then(|snapshot| snapshot.etag_repos.clone());\n    let repos_result = github.repos(repos_etag.as_deref()).await?;\n    let (raw_repos, etag_repos) = resolve(\n        repos_result,\n        previous_snapshot.as_ref().map(|snapshot| {\n            snapshot\n                .repos\n                .iter()\n                .map(|repo| crate::models::GitHubRepo {\n                    id: repo.id,\n                    name: repo.name.clone(),\n                    full_name: repo.full_name.clone(),\n                    description: repo.description.clone(),\n                    html_url: repo.html_url.clone(),\n                    homepage: repo.homepage.clone(),\n                    language: repo.language.clone(),\n                    stargazers_count: repo.stargazers_count,\n                    forks_count: repo.forks_count,\n                    topics: repo.topics.clone(),\n                    fork: repo.fork,\n                    archived: repo.archived,\n                    updated_at: repo.updated_at.clone(),\n                    pushed_at: None,\n                    languages_url: None,\n                    owner: None,\n                })\n                .collect()\n        }),\n        repos_etag,\n    )?\n    .ok_or_else(|| {\n        GitHubError::Decode(\"GitHub returned 304 without cached repositories\".to_owned())\n    })?;\n\n    let repos = normalize_repos(raw_repos, config);\n\n    // --- languages ---------------------------------------------------------\n    let mut repo_languages = previous_snapshot\n        .as_ref()\n        .map(|snapshot| snapshot.repo_languages.clone())\n        .unwrap_or_default();\n    let mut languages_changed = false;\n    let mut budget = config.language_budget;\n    let visibility = Visibility {\n        show_forks: config.show_forks,\n        show_archived: config.show_archived,\n    };\n\n    for repo in repos.iter().filter(|repo| visibility_allows(repo, config)) {\n        if repo.archived && !config.show_archived {\n            continue;\n        }\n        let cached = repo_languages.get(&repo.full_name).cloned();\n        let needs_fetch = matches!(&cached, None | Some(stats) if stats.bytes == 0)\n            || (cached.is_some() && repo.updated_at.is_some());\n        if !needs_fetch || budget == 0 {\n            continue;\n        }\n        budget -= 1;\n        let etag = cached.as_ref().and_then(|stats| stats.etag.clone());\n        match github.languages(&repo.full_name, etag.as_deref()).await {\n            Ok(Conditional {\n                value: Some(bytes),\n                etag,\n                ..\n            }) => {\n                repo_languages.insert(repo.full_name.clone(), RepoLanguages::from_bytes(bytes, etag));\n                languages_changed = true;\n            }\n            Ok(Conditional {\n                value: None,\n                etag: kept,\n                not_modified: true,\n            }) => {\n                if let Some(stats) = repo_languages.get_mut(&repo.full_name) {\n                    if stats.etag != kept {\n                        stats.etag = kept;\n                        languages_changed = true;\n                    }\n                }\n            }\n            Ok(_) => {}\n            Err(GitHubError::RateLimited { remaining, reset_at }) => {\n               