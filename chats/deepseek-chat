r> {\n        let parts: Vec<_> = full_name.split('/').collect();\n        if parts.len() != 2 || parts.iter().any(|p| p.is_empty() || *p == \".\" || *p == \"..\" || !p.chars().all(|c| c.is_ascii_alphanumeric() || \"-_.\".contains(c))) {\n            return Err(GitHubError::Decode(\"invalid repository identifier\".into()));\n        }\n        let (result, _) = self.get(&format!(\"{}/repos/{full_name}/languages\", self.base), etag).await?;\n        Ok(result)\n    }\n    async fn get<T: DeserializeOwned>(&self, raw: &str, etag: Option<&str>) -> Result<(Conditional<T>, HeaderMap), GitHubError> {\n        if self.blocked_until.lock().await.is_some_and(|t| t > std::time::Instant::now()) {\n            return Err(GitHubError::RateLimited { remaining: 0, reset_at: None });\n        }\n        let url = validate_url(raw, &self.base)?;\n        let mut request = self.http.get(url).header(\"Accept\", \"application/vnd.github+json\")\n            .header(\"X-GitHub-Api-Version\", \"2022-11-28\");\n        if let Some(token) = &self.token { request = request.bearer_auth(token); }\n        if let Some(value) = etag { request = request.header(IF_NONE_MATCH, value); }\n        let response = request.send().await.map_err(|e| GitHubError::Network(e.to_string()))?;\n        let status = response.status();\n        let headers = response.headers().clone();\n        let response_etag = headers.get(ETAG).and_then(|h| h.to_str().ok()).map(str::to_owned);\n        if status == StatusCode::NOT_MODIFIED {\n            return Ok((Conditional { value: None, etag: response_etag.or_else(|| etag.map(str::to_owned)), not_modified: true }, headers));\n        }\n        if status == StatusCode::TOO_MANY_REQUESTS || status == StatusCode::FORBIDDEN {\n            let reset = headers.get(\"x-ratelimit-reset\").and_then(|h| h.to_str().ok()).map(str::to_owned);\n            let retry = headers.get(\"retry-after\").and_then(|h| h.to_str().ok()).and_then(|s| s.parse::<u64>().ok());\n            let now