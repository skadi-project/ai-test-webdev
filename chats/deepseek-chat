              "content": "//! Thin, allocation-friendly wrapper around the GitHub REST API.\n//!\n//! Everything the site needs goes through [`GitHubClient`], which adds:\n//!\n//! * a descriptive `User-Agent` (required by GitHub),\n//! * optional bearer auth,\n//! * conditional requests (`If-None-Match`) so unchanged payloads do not count\n//!   against the rate limit,\n//! * explicit mapping of `403`/`429` + rate-limit headers to [`GitHubError::RateLimited`].\n\nuse std::time::Duration;\n\nuse reqwest::header::{\n    ACCEPT, AUTHORIZATION, ETAG, IF_NONE_MATCH, LINK, USER_AGENT, X_RATELIMIT_REMAINING,\n    X_RATELIMIT_RESET,\n};\nuse reqwest::{Client, StatusCode, Url};\nuse serde::de::DeserializeOwned;\n\nuse crate::config::Config;\nuse crate::github::error::GitHubError;\nuse crate::models::github::{GitHubRepo, GitHubUser, LanguageBytes};\n\nconst PER_PAGE: usize = 100;\n/// Hard cap on repository pages (~1000 repos) to bound a refresh cycle.\nconst MAX_PAGES: usize = 10;\n\n/// Result of a conditional GET.\n#[derive(Debug, Clone)]\npub struct Conditional<T> {\n    /// `None` when GitHub answered `304 Not Modified`.\n    pub value: Option<T>,\n    /// ETag to store for the next request (carried over on `304`).\n    pub etag: Option<String>,\n    pub not_modified: bool,\n}\n\nimpl<T> Conditional<T> {\n    fn not_modified(etag: Option<String>) -> Self {\n        Self {\n            value: None,\n            etag,\n            not_modified: true,\n        }\n    }\n}\n\n/// Parsed `Link` header, keeping only what pagination needs.\n#[derive(Debug, Clone, Default)]\npub struct LinkHeader {\n    pub next: Option<String>,\n}\n\nimpl LinkHeader {\n    /// Parses `Link: <...>; rel=\"next\", <...>; rel=\"last\"`.\n    pub fn parse(raw: &str) -> Self {\n        let mut next = None;\n        for part in raw.split(',') {\n            let Some((target, rest)) = part.split_once(';') else {\n                continue;\n            };\n            let url = target.trim().trim_start_matches('<').trim_end_matches('>');\n            if url.is_empty() {\n                continue;\n            }\n            for param in rest.split(';') {\n                let Some((key, value)) = param.split_once('=') else {\n                    continue;\n                };\n                if key.trim().eq_ignore_ascii_case(\"rel\") {\n                    let value = value.trim().trim_matches('\"');\n                    if value.eq_ignore_ascii_case(\"next\") {\n                        next = Some(url.to_owned());\n                    }\n                }\n            }\n        }\n        Self { next }\n    }\n}\n\nstruct RawResponse {\n    status: StatusCode,\n    etag: Option<String>,\n    next_page: Option<String>,\n    remaining: Option<u32>,\n    reset_at: Option<String>,\n    body: Vec<u8>,\n}\n\n/// GitHub REST client bound to one profile.\n#[derive(Debug, Clone)]\npub struct GitHubClient {\n    http: Client,\n    base: String,\n    username: String,\n    token: Option<String>,\n}\n\nimpl GitHubClient {\n    pub fn new(config: &Config) -> Result<Self, GitHubError> {\n        let http = Client::builder()\n            .user_agent(concat!(\"github-portfolio/\", env!(\"CARGO_PKG_VERSION\")))\n            .timeout(Duration::from_secs(20))\n            .connect_timeout(Duration::from_secs(10))\n            .pool_idle_timeout(Duration::from_secs(60))\n            .build()\n            .map_err(|err| GitHubError::Network(err.to_string()))?;\n        Ok(Self {\n            http,\n            base: config.github_api_base.clone(),\n            username: config.github_username.clone(),\n            token: config.github_token.clone(),\n        })\n    }\n\n    pub fn username(&self) -> &str {\n        &self.username\n    }\n\n    /// `GET /users/{user}`\n    pub async fn user(&self, etag: Option<&str>) -> Result<Conditional<GitHubUser>, GitHubError> {\n        let url = self.url(&format!(\"users/{}\", self.username))?;\n        let response = self.send(url, etag).await?;\n        if response.status == StatusCode::NOT_MODIFIED {\n            return Ok(Conditional::not_modified(etag.map(str::to_owned)));\n        }\n        let value = decode::<GitHubUser>(&response)?;\n        Ok(Conditional {\n            value: Some(value),\n            etag: response.etag,\n            not_modified: false,\n        })\n    }\n\n    /// `GET /users/{user}/repos` — follows pagination up to [`MAX_PAGES`].\n    ///\n    /// The conditional request is only applied to the first page: GitHub returns\n    /// one ETag per page, so a `304` on page 1 means the whole listing is\n    /// unchanged (the API sorts by `pushed`/`updated`, newest first).\n    pub async fn repos(\n        &self,\n        etag: Option<&str>,\n    ) -> Result<Conditional<Vec<GitHubRepo>>, GitHubError> {\n        let first = self.url(&format!(\n            \"users/{}/repos?per_page={PER_PAGE}&sort=updated&direction=desc&type=owner\",\n            self.username\n        ))?;\n        let response = self.send(first, etag).await?;\n        if response.status == StatusCode::NOT_MODIFIED {\n            return Ok(Conditional::not_modified(etag.map(str::to_owned)));\n        }\n\n        let mut repos: Vec<GitHubRepo> = decode(&response)?;\n        let mut etag_out = response.etag;\n        let mut next_page = response.next_page;\n        let mut page = 1usize;\n\n        while let Some(next_url) = next_page {\n            if page >= MAX_PAGES {\n                tracing::warn!(\n                    limit = MAX_PAGES,\n                    collected = repos.len(),\n                    \"repository pagination limit reached; remaining pages skipped\"\n                );\n                break;\n            }\n            let url = validate_url(&next_url, &self.base)?;\n            let page_response = self.send(url, None).await?;\n            let mut extra: Vec<GitHubRepo> = decode(&page_response)?;\n            if extra.is_empty() {\n                break;\n            }\n            repos.append(&mut extra);\n            next_page = page_response.next_page;\n            page += 1;\n        }\n\n        // Defensive: GitHub occasionally repeats entries across page boundaries.\n        repos.dedup_by_key(|repo| repo.id);\n        repos.sort_by(|a, b| b.updated_at.cmp(&a.updated_at));\n\n        Ok(Conditional {\n            value: Some(repos),\n            etag: etag_out.take(),\n            not_modified: false,\n        })\n    }\n\n    /// `GET /repos/{owner}/{repo}/languages`\n    pub async fn languages(\n        &self,\n        full_name: &str,\n        etag: Option<&str>,\n    ) -> Result<Conditional<LanguageBytes>, GitHubError> {\n        if !is_safe_full_name(full_name) {\n            return Err(GitHubError::Decode(format!(\n                \"refusing to request languages for suspicious name {full_name:?}\"\n            )));\n        }\n        let url = self.url(&format!(\"repos/{full_name}/languages\"))?;\n        let response = self.send(url, etag).await?;\n        if response.status == StatusCode::NOT_MODIFIED {\n            return Ok(Conditional::not_modified(etag.map(str::to_owned)));\n        }\n        let value = decode::<LanguageBytes>(&response)?;\n        Ok(Conditional {\n            value: Some(value),\n            etag: response.etag,\n            not_modified: false,\n        })\n    }\n\n    fn url(&self, path: &str) -> Result<Url, GitHubError> {\n        let joined = format!(\"{}/{path}\", self.base.trim_end_matches('/'));\n        Url::parse(&joined).map_err(|err| GitHubError::Decode(format!(\"bad url {joined}: {err}\")))\n    }\n\n    async fn send(&self, url: Url, etag: Option<&str>) -> Result<RawResponse, GitHubError> {\n        let mut request = self\n            .http\n            .get(url.clone())\n            .header(ACCEPT, \"application/vnd.github+json\")\n            .header(\"X-GitHub-Api-Version\", \"2022-11-28\")\n            .header(USER_AGENT, concat!(\"github-portfolio/\", env!(\"CARGO_PKG_VERSION\")));\n        if let Some(token) = &self.token {\n            request = request.header(AUTHORIZATION, format!(\"Bearer {token}\"));\n        }\n        if let Some(etag) = etag {\n            request = request.header(IF_NONE_MATCH, etag);\n        }\n\n        let response = request\n            .send()\n            .await\n            .map_err(|err| GitHubError::Network(format!(\"{url}: {err}\")))?;\n\n        let status = response.status();\n        let headers = response.headers();\n        let out = RawResponse {\n            status,\n            etag: headers\n                .get(ETAG)\n                .and_then(|v| v.to_str().ok())\n                .map(str::to_owned),\n            next_page: headers\n                .get(LINK)\n                .and_then(|v| v.to_str().ok())\n                .map(LinkHeader::parse)\n                .and_then(|link| link.next),\n            remaining: headers\n                .get(X_RATELIMIT_REMAINING)\n                .and_then(|v| v.to_str().ok())\n                .and_then(|v| v.parse().ok()),\n            reset_at: headers\n                .get(X_RATELIMIT_RESET)\n                .and_then(|v| v.to_str().ok())\n                .map(str::to_owned),\n            body: response\n                .bytes()\n                .await\n                .map_err(|err| GitHubError::Network(err.to_string()))?\n                .to_vec(),\n        };\n\n        match out.status {\n            StatusCode::NOT_MODIFIED | StatusCode::OK => Ok(out),\n            StatusCode::NOT_FOUND => Err(GitHubError::NotFound),\n            StatusCode::UNAUTHORIZED => Err(GitHubError::Unauthorized {\n                status: 401,\n            }),\n            StatusCode::FORBIDDEN | StatusCode::TOO_MANY_REQUESTS\n                if out.remaining == Some(0) || out.reset_at.is_some() =>\n            {\n                Err(GitHubError::RateLimited {\n                    remaining: out.remaining.unwrap_or(0),\n                    reset_at: out.reset_at,\n                })\n            }\n            StatusCode::FORBIDDEN => Err(GitHubError::Unauthorized { status: 403 }),\n            other => Err(GitHubError::UnexpectedStatus {\n                status: other.as_u16(),\n                body: preview(&out.body),\n            }),\n        }\n    }\n}\n\nfn decode<T: DeserializeOwned>(response: &RawResponse) -> Result<T, GitHubError> {\n    serde_json::from_slice(&response.body).map_err(|err| GitHubError::Decode(err.to_string()))\n}\n\nfn preview(bytes: &[u8]) -> String {\n    let text = String::from_utf8_lossy(bytes);\n    text.chars().take(300).collect()\n}\n\n/// Keeps pagination URLs on the configured API host (no token leakage to other hosts).\nfn validate_url(raw: &str, base: &str) -> Result<Url, GitHubError> {\n    let url = Url::parse(raw)\n        .map_err(|err| GitHubError::Decode(format!(\"invalid pagination url {raw}: {err}\")))?;\n    let base_url = Url::parse(base)\n        .map_err(|err| GitHubError::Decode(format!(\"invalid api base {base}: {err}\")))?;\n    if url.scheme() != base_url.scheme() || url.host_str() != base_url.host_str() {\n        return Err(GitHubError::Decode(format!(\n            \"pagination url host mismatch: {url}\"\n        )));\n    }\n    Ok(url)\n}\n\n/// Guards against path traversal in `owner/repo` identifiers.\nfn is_safe_full_name(full_name: &str) -> bool {\n    let mut parts = full_name.split('/');\n    let (Some(owner), Some(repo), None) = (parts.next(), parts.next(), parts.next()) else {\n        return false;\n    };\n    let valid = |part: &str| {\n        !part.is_empty()\n            && part.len() <= 100\n            && part\n                .chars()\n                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.'))\n    };\n    valid(owner) && valid(repo)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn link_header_extracts_next() {\n        let raw = r#\"<https://api.github.com/user/1/repos?page=2>; rel=\"next\", <https://api.github.com/user/1/repos?page=5>; rel=\"last\"\"#;\n        let link = LinkHeader::parse(raw);\n        assert_eq!(\n            link.next.as_deref(),\n            Some(\"https://api.github.com/user/1/repos?page=2\")\n        );\n    }\n\n    #[test]\n    fn link_header_without_next() {\n        let link = LinkHeader::parse(r#\"<https://api.github.com/x?page=1>; rel=\"first\"\"#);\n        assert!(link.next.is_none());\n        assert!(LinkHeader::parse(\"\").next.is_none());\n        assert!(LinkHeader::parse(\"garbage\").next.is_none());\n    }\n\n    #[test]\n    fn full_name_guard() {\n        assert!(is_safe_full_name(\"octocat/Hello-World\"));\n        assert!(is_safe_full_name(\"a/b\"));\n        assert!(!is_safe_full_name(\"octocat\"));\n        assert!(!is_safe_full_name(\"../../etc/passwd\"));\n        assert!(!is_safe_full_name(\"a/b/c\"));\n        assert!(!is_safe_full_name(\"a/ b\"));\n    }\n\n    #[test]\n    fn url_validation_rejects_foreign_hosts() {\n        assert!(validate_url(\"https://api.github.com/repos?a=1\", \"https://api.github.com\").is_ok());\n        assert!(validate_url(\"https://evil.example/repos\", \"https://api.github.com\").is_err());\n        assert!(validate_url(\"not a url\", \"https://api.github.com\").is_err());\n    }\n}",
