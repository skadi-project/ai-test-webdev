              "content": "/* ==========================================================================\n   REPO / FOLIO — editorial portfolio, cream paper & ink, lime accent\n   ========================================================================== */\n\n/* --- Design tokens ------------------------------------------------------- */\n:root {\n  color-scheme: light;\n\n  /* Palette: warm paper, near-black ink, lime signal, clay secondary */\n  --paper: #f4f1e8;\n  --paper-2: #efeadc;\n  --paper-3: #e7e1d0;\n  --ink: #16170f;\n  --ink-2: #3d3f33;\n  --ink-3: #6b6d5e;\n  --ink-4: #9a9c8d;\n  --line: #d8d2bf;\n  --line-strong: #b9b29c;\n  --lime: #c8f751;\n  --lime-ink: #1e2a00;\n  --lime-soft: #e6fbb4;\n  --clay: #b4462b;\n  --card: #fbf9f3;\n  --shadow-sm: 0 1px 2px rgba(22, 23, 15, 0.06), 0 2px 8px rgba(22, 23, 15, 0.04);\n  --shadow-md: 0 2px 4px rgba(22, 23, 15, 0.05), 0 12px 28px rgba(22, 23, 15, 0.09);\n\n  --font-display: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, \"Times New Roman\", serif;\n  --font-sans: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n\n  --radius-sm: 8px;\n  --radius: 14px;\n  --radius-lg: 22px;\n  --shell: 1240px;\n  --ease: cubic-bezier(0.22, 0.7, 0.3, 1);\n  --dur: 220ms;\n}\n\n[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --paper: #0e0f0c;\n  --paper-2: #14150f;\n  --paper-3: #1b1d16;\n  --ink: #f2f0e6;\n  --ink-2: #d3d2c4;\n  --ink-3: #a3a395;\n  --ink-4: #78796d;\n  --line: #2a2c23;\n  --line-strong: #3d4034;\n  --lime: #c8f751;\n  --lime-ink: #131a00;\n  --lime-soft: #26320a;\n  --clay: #e4704f;\n  --card: #15170f;\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);\n  --shadow-md: 0 12px 32px rgba(0, 0, 0, 0.55);\n}\n\n/* --- Reset --------------------------------------------------------------- */\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\nhtml { -webkit-text-size-adjust: 100%; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background-color: var(--paper);\n  background-image:\n    radial-gradient(circle at 12% -10%, rgba(200, 247, 81, 0.20), transparent 42%),\n    radial-gradient(circle at 92% 4%, rgba(180, 70, 43, 0.10), transparent 38%);\n  background-attachment: fixed;\n  color: var(--ink);\n  font-family: var(--font-sans);\n  font-size: 16px;\n  line-height: 1.55;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n\n[data-theme=\"dark\"] body {\n  background-image:\n    radial-gradient(circle at 12% -10%, rgba(200, 247, 81, 0.12), transparent 45%),\n    radial-gradient(circle at 92% 4%, rgba(228, 112, 79, 0.10), transparent 40%);\n}\n\nimg { max-width: 100%; height: auto; display: block; }\nbutton { font: inherit; color: inherit; }\na { color: inherit; }\n\n:focus-visible {\n  outline: 2.5px solid var(--ink);\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n[data-theme=\"dark\"] :focus-visible { outline-color: var(--lime); }\n\n.skip-link {\n  position: absolute;\n  left: 12px;\n  top: -60px;\n  z-index: 50;\n  padding: 10px 16px;\n  background: var(--ink);\n  color: var(--paper);\n  border-radius: 0 0 var(--radius-sm) var(--radius-sm);\n  text-decoration: none;\n  font-family: var(--font-mono);\n  font-size: 0.8rem;\n  transition: top var(--dur) var(--ease);\n}\n.skip-link:focus { top: 0; }\n\n.visually-hidden {\n  position: absolute;\n  width: 1px; height: 1px;\n  margin: -1px; padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* --- Shell --------------------------------------------------------------- */\n.page {\n  max-width: var(--shell);\n  margin: 0 auto;\n  padding: clamp(16px, 3vw, 34px) clamp(16px, 4vw, 40px) 48px;\n}\n\n/* --- Masthead ------------------------------------------------------------ */\n.masthead {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  padding-bottom: 18px;\n  border-bottom: 1.5px solid var(--line-strong);\n  margin-bottom: clamp(20px, 3vw, 34px);\n}\n\n.wordmark {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-family: var(--font-mono);\n  font-size: clamp(0.85rem, 2.2vw, 1rem);\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  text-decoration: none;\n}\n\n.wordmark-mark { color: var(--clay); font-size: 0.8em; }\n.wordmark-slash { color: var(--clay); }\n\n.masthead-side {\n  display: flex;\n  align-items: center;\n  gap: clamp(10px, 2vw, 20px);\n  flex-wrap: wrap;\n}\n\n.masthead-note {\n  margin: 0;\n  font-family: var(--font-mono);\n  font-size: 0.7rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--ink-3);\n}\n.masthead-note[data-state=\"live\"] { color: var(--ink-3); }\n.masthead-note[data-state=\"stale\"] { color: var(--clay); }\n.masthead-note[data-state=\"error\"] { color: var(--clay); }\n\n.theme-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 14px;\n  background: transparent;\n  border: 1.5px solid var(--line-strong);\n  border-radius: 999px;\n  cursor: pointer;\n  font-family: var(--font-mono);\n  font-size: 0.7rem;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);\n}\n.theme-toggle:hover { background: var(--paper-3); transform: translateY(-1px); }\n.theme-toggle-icon {\n  width: 12px; height: 12px;\n  border-radius: 50%;\n  background: var(--ink);\n  box-shadow: inset -3.5px -1px 0 0 var(--paper);\n  transition: box-shadow var(--dur) var(--ease), background var(--dur) var(--ease);\n}\n[data-theme=\"dark\"] .theme-toggle-icon {\n  background: var(--lime);\n  box-shadow: 0 0 0 2px rgba(200, 247, 81, 0.25);\n}\n\n/* --- Layout -------------------------------------------------------------- */\n.layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: clamp(20px, 3vw, 32px);\n  align-items: start;\n}\n\n@media (min-width: 900px) {\n  .layout { grid-template-columns: minmax(280px, 340px) minmax(0, 1fr); }\n  .profile { position: sticky; top: 24px; }\n}\n\n/* --- Profile ------------------------------------------------------------- */\n.profile { display: grid; gap: clamp(16px, 2vw, 22px); }\n\n.profile-card,\n.panel {\n  background: var(--card);\n  border: 1.5px solid var(--line);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-sm);\n}\n\n.profile-card {\n  position: relative;\n  padding: clamp(20px, 3vw, 26px);\n  overflow: hidden;\n}\n\n.profile-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 0 auto 0;\n  height: 5px;\n  background: linear-gradient(90deg, var(--lime) 0%, var(--clay) 100%);\n}\n\n.profile-body { display: grid; gap: 2px; }\n\n.avatar-frame {\n  width: 96px; height: 96px;\n  border-radius: 50%;\n  padding: 3px;\n  background: var(--paper);\n  border: 1.5px solid var(--line-strong);\n  margin-bottom: 14px;\n  transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);\n}\n.profile-card:hover .avatar-frame { transform: rotate(-2deg) scale(1.02); border-color: var(--lime); }\n.avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: var(--paper-3); }\n\n.profile-name {\n  font-family: var(--font-display);\n  font-size: clamp(1.55rem, 4vw, 1.95rem);\n  line-height: 1.1;\n  letter-spacing: -0.015em;\n  margin: 0 0 4px;\n  font-weight: 600;\n}\n\n.profile-login { margin: 0 0 12px; }\n.profile-handle {\n  font-family: var(--font-mono);\n  font-size: 0.8rem;\n  color: var(--ink-3);\n  text-decoration: none;\n  border-bottom: 1px solid transparent;\n  transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);\n}\n.profile-handle:hover { color: var(--ink); border-bottom-color: var(--ink); }\n\n.profile-bio {\n  margin: 0 0 16px;\n  color: var(--ink-2);\n  font-size: 0.94rem;\n  line-height: 1.6;\n}\n\n.profile-meta {\n  list-style: none;\n  margin: 0 0 18px;\n  padding: 0;\n  display: grid;\n  gap: 8px;\n  font-size: 0.85rem;\n  color: var(--ink-2);\n}\n.profile-meta li { display: flex; align-items: baseline; gap: 9px; min-width: 0; }\n.profile-meta .meta-icon {\n  flex: none;\n  color: var(--ink-4);\n  font-family: var(--font-mono);\n  font-size: 0.78rem;\n  width: 14px;\n  text-align: center;\n}\n.profile-meta a {\n  text-decoration: none;\n  border-bottom: 1px solid var(--line-strong);\n  overflow-wrap: anywhere;\n  transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);\n}\n.profile-meta a:hover { border-bottom-color: var(--lime); color: var(--ink); }\n.profile-meta span { overflow-wrap: anywhere; }\n\n.profile-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n  margin: 0 0 18px;\n  padding: 14px 0 0;\n  border-top: 1.5px solid var(--line);\n}\n.stat { display: grid; gap: 2px; }\n.stat dt {\n  font-family: var(--font-mono);\n  font-size: 0.62rem;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--ink-4);\n}\n.stat dd {\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: 1.35rem;\n  font-variant-numeric: tabular-nums;\n  letter-spacing: -0.01em;\n}\n\n.profile-cta { width: 100%; justify-content: space-between; }\n\n/* --- Buttons ------------------------------------------------------------- */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 16px;\n  border-radius: 999px;\n  font-family: var(--font-mono);\n  font-size: 0.74rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n  cursor: pointer;\n  border: 1.5px solid transparent;\n  transition: background var(--dur) var(--ease), color var(--dur) var(--ease),\n    border-color var(--dur) var(--ease), transform var(--dur) var(--ease);\n}\n.btn:hover { transform: translateY(-1px); }\n.btn:active { transform: translateY(0); }\n.btn-ghost { background: var(--ink); color: var(--paper); }\n.btn-ghost:hover { background: var(--lime); color: var(--lime-ink); }\n.btn-quiet {\n  background: transparent;\n  border-color: var(--line-strong);\n  color: var(--ink);\n}\n.btn-quiet:hover { background: var(--paper-3); border-color: var(--ink-3); }\n\n/* --- Panels & language chart -------------------------------------------- */\n.panel { padding: clamp(18px, 2.5vw, 22px); }\n.panel-title {\n  margin: 0 0 2px;\n  font-family: var(--font-mono);\n  font-size: 0.72rem;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--ink-3);\n}\n.panel-hint {\n  margin: 0 0 14px;\n  font-size: 0.78rem;\n  color: var(--ink-4);\n}\n\n.lang-chart {\n  display: flex;\n  height: 12px;\n  width: 100%;\n  border-radius: 999px;\n  overflow: hidden;\n  background: var(--paper-3);\n  margin-bottom: 16px;\n  gap: 2px;\n}\n.lang-chart .lang-seg {\n  height: 100%;\n  min-width: 3px;\n  transform-origin: left center;\n  animation: grow-in 520ms var(--ease) both;\n}\n@keyframes grow-in {\n  from { transform: scaleX(0); }\n  to { transform: scaleX(1); }\n}\n\n.lang-legend {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 7px;\n  font-size: 0.82rem;\n}\n.lang-legend li {\n  display: grid;\n  grid-template-columns: 10px 1fr auto;\n  align-items: center;\n  gap: 9px;\n}\n.lang-dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }\n.lang-name { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.lang-pct {\n  font-family: var(--font-mono);\n  font-size: 0.72rem;\n  color: var(--ink-3);\n  font-variant-numeric: tabular-nums;\n}\n\n/* --- Content ------------------------------------------------------------- */\n.content { min-width: 0; }\n\n.content-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-bottom: 14px;\n}\n.content-title {\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: clamp(1.3rem, 3vw, 1.6rem);\n  font-weight: 600;\n  letter-spacing: -0.01em;\n}\n.content-count {\n  margin: 0;\n  font-family: var(--font-mono);\n  font-size: 0.72rem;\n  letter-spacing: 0.06em;\n  color: var(--ink-3);\n  text-transform: uppercase;\n}\n\n/* --- Controls ------------------------------------------------------------ */\n.controls {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 12px;\n  padding: 14px;\n  margin-bottom: 18px;\n  background: var(--card);\n  border: 1.5px solid var(--line);\n  border-radius: var(--radius);\n}\n@media (min-width: 620px) {\n  .controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .field-search { grid-column: 1 / -1; }\n}\n@media (min-width: 1080px) {\n  .controls { grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); align-items: end; }\n  .field-search { grid-column: auto; }\n}\n\n.field { display: grid; gap: 6px; min-width: 0; }\n.field-label {\n  font-family: var(--font-mono);\n  font-size: 0.63rem;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--ink-4);\n}\n\n.search-wrap { position: relative; display: block; }\n.search-icon {\n  position: absolute;\n  left: 12px;\n  top: 50%;\n  transform: translateY(-50%);\n  color: var(--ink-4);\n  display: grid;\n  place-items: center;\n  pointer-events: none;\n}\n\n.input {\n  width: 100%;\n  padding: 10px 12px;\n  background: var(--paper);\n  color: var(--ink);\n  border: 1.5px solid var(--line);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-sans);\n  font-size: 0.88rem;\n  transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease);\n}\n.input::placeholder { color: var(--ink-4); }\n.input:hover { border-color: var(--line-strong); }\n.input:focus {\n  outline: none;\n  border-color: var(--ink);\n  box-shadow: 0 0 0 3px rgba(200, 247, 81, 0.4);\n  background: var(--card);\n}\n[data-theme=\"dark\"] .input:focus { border-color: var(--lime); box-shadow: 0 0 0 3px rgba(200, 247, 81, 0.16); }\n.field-search .input { padding-left: 36px; }\n\n.select {\n  appearance: none;\n  cursor: pointer;\n  background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),\n    linear-gradient(135deg, currentColor 50%, transparent 50%);\n  background-position: calc(100% - 16px) 55%, calc(100% - 11px) 55%;\n  background-size: 5px 5px, 5px 5px;\n  background-repeat: no-repeat;\n  padding-right: 32px;\n}\n.select option { background: var(--card); color: var(--ink); }\n\n.switches {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-wrap: wrap;\n  grid-column: 1 / -1;\n  padding-top: 2px;\n}\n@media (min-width: 1080px) { .switches { grid-column: auto; padding-top: 0; } }\n\n.switch {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  cursor: pointer;\n  user-select: none;\n  font-size: 0.82rem;\n  color: var(--ink-2);\n}\n.switch input {\n  position: absolute;\n  opacity: 0;\n  width: 1px; height: 1px;\n}\n.switch-track {\n  position: relative;\n  width: 38px; height: 21px;\n  border-radius: 999px;\n  background: var(--paper-3);\n  border: 1.5px solid var(--line-strong);\n  transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);\n  flex: none;\n}\n.switch-dot {\n  position: absolute;\n  top: 50%; left: 2px;\n  width: 13px; height: 13px;\n  border-radius: 50%;\n  background: var(--ink-4);\n  transform: translateY(-50%);\n  transition: transform var(--dur) var(--ease), background var(--dur) var(--ease);\n}\n.switch input:checked + .switch-track { background: var(--lime); border-color: var(--ink); }\n.switch input:checked + .switch-track .switch-dot { transform: translate(17px, -50%); background: var(--lime-ink); }\n.switch input:focus-visible + .switch-track { outline: 2.5px solid var(--ink); outline-offset: 3px; }\n[data-theme=\"dark\"] .switch input:focus-visible + .switch-track { outline-color: var(--lime); }\n\n/* --- Repo grid ----------------------------------------------------------- */\n.repo-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 14px;\n}\n@media (min-width: 700px) { .repo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1240px) { .repo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n\n.repo-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 18px;\n  background: var(--card);\n  border: 1.5px solid var(--line);\n  border-radius: var(--radius);\n  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),\n    border-color var(--dur) var(--ease);\n  animation: card-in 380ms var(--ease) both;\n}\n@keyframes card-in {\n  from { opacity: 0; transform: translateY(8px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.repo-card:hover {\n  transform: translateY(-3px);\n  box-shadow: var(--shadow-md);\n  border-color: var(--line-strong);\n}\n.repo-card::after {\n  content: \"\";\n  position: absolute;\n  left: 18px; right: 18px; bottom: 0;\n  height: 2px;\n  background: var(--lime);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 320ms var(--ease);\n  border-radius: 2px;\n}\n.repo-card:hover::after { transform: scaleX(1); }\n\n.repo-card[data-pinned=\"true\"] {\n  border-color: var(--line-strong);\n  background: linear-gradient(180deg, var(--lime-soft) 0%, var(--card) 34%);\n}\n[data-theme=\"dark\"] .repo-card[data-pinned=\"true\"] { background: linear-gradient(180deg, rgba(200, 247, 81, 0.10) 0%, var(--card) 40%); }\n\n.repo-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.repo-name {\n  margin: 0;\n  font-family: var(--font-mono);\n  font-size: 0.98rem;\n  font-weight: 600;\n  letter-spacing: -0.01em;\n  overflow-wrap: anywhere;\n}\n.repo-name a {\n  text-decoration: none;\n  background-image: linear-gradient(var(--lime), var(--lime));\n  background-size: 0% 2px;\n  background-repeat: no-repeat;\n  background-position: 0 100%;\n  transition: background-size var(--dur) var(--ease);\n}\n.repo-name a:hover { background-size: 100% 2px; }\n\n.pin-badge {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  background: var(--ink);\n  color: var(--lime);\n  font-family: var(--font-mono);\n  font-size: 0.6rem;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.repo-desc {\n  margin: 0;\n  color: var(--ink-2);\n  font-size: 0.88rem;\n  line-height: 1.55;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.repo-desc[data-empty=\"true\"] { color: var(--ink-4); font-style: italic; }\n\n.repo-topics {\n  list-style: none;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n}\n.topic-chip {\n  padding: 2px 8px;\n  border-radius: 999px;\n  border: 1px solid var(--line-strong);\n  font-family: var(--font-mono);\n  font-size: 0.66rem;\n  color: var(--ink-3);\n  background: transparent;\n  cursor: pointer;\n  transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);\n}\n.topic-chip:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }\n\n.repo-foot {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-top: auto;\n  padding-top: 10px;\n  border-top: 1px solid var(--line);\n  font-family: var(--font-mono);\n  font-size: 0.7rem;\n  color: var(--ink-3);\n}\n\n.repo-lang { display: inline-flex; align-items: center; gap: 6px; }\n.repo-lang .lang-dot { width: 9px; height: 9px; border-radius: 50%; }\n\n.repo-metric { display: inline-flex; align-items: center; gap: 4px; font-variant-numeric: tabular-nums; }\n.repo-metric svg { opacity: 0.8; }\n\n.repo-links { display: inline-flex; align-items: center; gap: 10px; mar