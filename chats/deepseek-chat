              "content": "//! JSON API handlers.\n\nuse std::collections::HashSet;\n\nuse axum::extract::{Query, State};\nuse axum::http::{header, HeaderMap, HeaderValue, StatusCode};\nuse axum::response::{IntoResponse, Response};\nuse axum::Json;\nuse chrono::{DateTime, Duration as ChronoDuration, Utc};\nuse serde::Serialize;\n\nuse crate::error::AppError;\nuse crate::filters::{self, RepoQuery, Visibility};\nuse crate::models::{LanguageStat, Profile, Repo, Snapshot};\nuse crate::state::{AppState, RefreshOutcome};\n\n/// `GET /api/profile`\npub async fn profile(State(state): State<AppState>) -> Result<Response, AppError> {\n    let snapshot = require_snapshot(&state)?;\n    let body = ProfileResponse {\n        profile: snapshot.profile.clone(),\n        updated_at: Some(snapshot.updated_at),\n        stale: is_stale(&state, snapshot.updated_at),\n    };\n    let etag = etag_for(\"profile\", &[snapshot.updated_at.to_rfc3339().as_str()]);\n    Ok(conditional_json(&body, &etag))\n}\n\n/// `GET /api/repos`\npub async fn repos(\n    State(state): State<AppState>,\n    Query(query): Query<RepoQuery>,\n) -> Result<Response, AppError> {\n    let snapshot = require_snapshot(&state)?;\n    let defaults = Visibility {\n        show_forks: state.config.show_forks,\n        show_archived: state.config.show_archived,\n    };\n    let filter = filters::Filter::from_query(&query, defaults);\n    let selected: Vec<Repo> = filter.apply(&snapshot.repos, &state.config.pinned_repos);\n\n    let etag = etag_for(\n        \"repos\",\n        &[\n            snapshot.updated_at.to_rfc3339().as_str(),\n            filter.search.as_deref().unwrap_or(\"\"),\n            filter.language.as_deref().unwrap_or(\"\"),\n            filter.topic.as_deref().unwrap_or(\"\"),\n            filter.sort.as_str(),\n            if filter.visibility.show_forks { \"1\" } else { \"0\" },\n            if filter.visibility.show_archived { \"1\" } else { \"0\" },\n        ],\n    );\n\n    let body = ReposResponse {\n        languages: snapshot.aggregate_languages(),\n        available_languages: filters::available_languages(&snapshot.repos, filter.visibility),\n        available_topics: filters::available_topics(&snapshot.repos, filter.visibility),\n        total: selected.len(),\n        languages_complete: languages_complete(snapshot.as_ref(), filter.visibility),\n        updated_at: Some(snapshot.updated_at),\n        stale: is_stale(&state, snapshot.updated_at),\n        defaults: DefaultsResponse { show_forks: defaults.show_forks, show_archived: defaults.show_archived },\n        repos: selected,\n    };\n    Ok(conditional_json(&body, &etag))\n}\n\n/// `POST /api/refresh` — protected by `ADMIN_TOKEN`.\npub async fn refresh(\n    State(state): State<AppState>,\n    headers: HeaderMap,\n) -> Result<Response, AppError> {\n    authorize(&state, &headers)?;\n    let started = std::time::Instant::now();\n    let outcome = state.refresh_now().await;\n    let latency_ms = started.elapsed().as_millis() as u64;\n\n    let snapshot = state.snapshot();\n    let (status, message) = match outcome {\n        RefreshOutcome::Updated => (StatusCode::OK, \"updated\"),\n        RefreshOutcome::NotModified => (StatusCode::OK, \"not_modified\"),\n        RefreshOutcome::Failed => (StatusCode::BAD_GATEWAY, \"failed\"),\n    };\n    if outcome == RefreshOutcome::Failed {\n        // Surface the failure while making it clear the old snapshot is still served.\n        let body = RefreshResponse {\n            status: message,\n            latency_ms,\n            repos: snapshot.as_ref().map(|s| s.repos.len()).unwrap_or(0),\n            updated_at: snapshot.as_ref().map(|s| s.updated_at),\n            error: Some(\"GitHub request failed; previous snapshot is still served\".to_owned()),\n        };\n        return Ok((status, Json(body)).into_response());\n    }\n    let body = RefreshResponse {\n        status: message,\n        latency_ms,\n        repos: snapshot.as_ref().map(|s| s.repos.len()).unwrap_or(0),\n        updated_at: snapshot.as_ref().map(|s| s.updated_at),\n        error: None,\n    };\n    Ok((status, Json(body)).into_response())\n}\n\n/// Fallback handler for unknown paths.\npub async fn not_found() -> Response {\n    let body = serde_json::json!({\n        \"error\": \"not found\",\n        \"code\": \"not_found\",\n        \"hint\": \"available routes: /, /api/profile, /api/repos, /api/refresh, /api/health\"\n    });\n    (StatusCode::NOT_FOUND, Json(body)).into_response()\n}\n\nfn require_snapshot(state: &AppState) -> Result<std::sync::Arc<Snapshot>, AppError> {\n    state\n        .snapshot()\n        .ok_or(AppError::CacheCold(\"waiting for the first successful GitHub fetch\"))\n}\n\n/// Compares the admin token without leaking timing information.\nfn authorize(state: &AppState, headers: &HeaderMap) -> Result<(), AppError> {\n    let expected = state\n        .config\n        .admin_token\n        .as_deref()\n        .ok_or(AppError::Unauthorized)?;\n    let provided = headers\n        .get(\"x-admin-token\")\n        .or_else(|| headers.get(header::AUTHORIZATION))\n        .and_then(|value| value.to_str().ok())\n        .map(|value| {\n            value\n                .strip_prefix(\"Bearer \")\n                .or_else(|| value.strip_prefix(\"bearer \"))\n                .unwrap_or(value)\n                .trim()\n        })\n        .filter(|value| !value.is_empty())\n        .ok_or(AppError::Unauthorized)?;\n    if constant_time_eq(provided.as_bytes(), expected.as_bytes()) {\n        Ok(())\n    } else {\n        Err(AppError::Unauthorized)\n    }\n}\n\nfn constant_time_eq(a: &[u8], b: &[u8]) -> bool {\n    if a.len() != b.len() {\n        return false;\n    }\n    let mut diff = 0u8;\n    for (x, y) in a.iter().zip(b.iter()) {\n        diff |= x ^ y;\n    }\n    diff == 0\n}\n\n/// Snapshot older than two refresh intervals is reported as stale to the UI.\nfn is_stale(state: &AppState, updated_at: DateTime<Utc>) -> bool {\n    let interval = ChronoDuration::from_std(state.config.refresh_interval)\n        .unwrap_or_else(|_| ChronoDuration::seconds(300));\n    Utc::now() - updated_at > interval * 2\n}\n\n/// True when every visible repository has cached language bytes.\nfn languages_complete(snapshot: &Snapshot, visibility: Visibility) -> bool {\n    snapshot.repos.iter().filter(|repo| {\n        (visibility.show_forks || !repo.fork) && (visibility.show_archived || !repo.archived)\n    }).all(|repo| {\n        snapshot\n            .repo_languages\n            .get(&repo.full_name)\n            .map(|stats| stats.bytes > 0)\n            .unwrap_or(false)\n    })\n}\n\n/// Strong-ish validator built from the snapshot timestamp plus the query shape.\nfn etag_for(namespace: &str, parts: &[&str]) -> String {\n    format!(\"\\\"{namespace}-{}\\\"\", fnv1a_64(parts.join(\"\\u{1f}\")))\n}\n\nfn fnv1a_64(input: String) -> u64 {\n    let mut hash: u64 = 0xcbf29ce484222325;\n    for byte in input.as_bytes() {\n        hash ^= u64::from(*byte);\n        hash = hash.wrapping_mul(0x100000001b3);\n    }\n    hash\n}\n\n/// Serializes `body` and honours `If-None-Match` when the client sends our ETag.\nfn conditional_json<T: Serialize>(body: &T, etag: &str) -> Response {\n    let mut response = Json(body).into_response();\n    if let Ok(value) = HeaderValue::from_str(etag) {\n        response.headers_mut().insert(header::ETAG, value);\n    }\n    response\n}\n\n/// Marker type so `conditional_json` can stay generic while handlers stay readable.\nfn not_modified(etag: &str) -> Response {\n    let mut response = StatusCode::NOT_MODIFIED.into_response();\n    if let Ok(value) = HeaderValue::from_str(etag) {\n        response.headers_mut().insert(header::ETAG, value);\n    }\n    response\n}\n\n/// Shared `ETag` comparison used by both handlers.\npub fn matches_etag(headers: &HeaderMap, etag: &str) -> bool {\n    headers\n        .get(header::IF_NONE_MATCH)\n        .and_then(|value| value.to_str().ok())\n        .map(|value| value.split(',').any(|candidate| candidate.trim() == etag || candidate.trim() == \"*\"))\n        .unwrap_or(false)\n}\n\n#[derive(Debug, Serialize)]\npub struct ProfileResponse {\n    pub profile: Profile,\n    pub updated_at: Option<DateTime<Utc>>,\n    pub stale: bool,\n}\n\n#[derive(Debug, Serialize)]\npub struct ReposResponse {\n    pub repos: Vec<Repo>,\n    pub languages: Vec<LanguageStat>,\n    pub available_languages: Vec<String>,\n    pub available_topics: Vec<String>,\n    pub total: usize,\n    pub updated_at: Option<DateTime<Utc>>,\n    pub stale: bool,\n    pub languages_complete: bool,\n    pub defaults: DefaultsResponse,\n}\n\n#[derive(Debug, Clone, Copy, Serialize)]\npub struct DefaultsResponse {\n    pub show_forks: bool,\n    pub show_archived: bool,\n}\n\n#[derive(Debug, Serialize)]\npub struct RefreshResponse {\n    pub status: &'static str,\n    pub latency_ms: u64,\n    pub repos: usize,\n    pub updated_at: Option<DateTime<Utc>>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub error: Option<String>,\n}\n\n/// Unused-but-public helpers referenced by tests keep the surface explicit.\npub(crate) fn unused_hashes(repos: &[Repo]) -> HashSet<u64> {\n    repos.iter().map(|repo| repo.id).collect()\n}\n\n#[allow(dead_code)]\nfn _not_modified_reference(etag: &str) -> Response {\n    not_modified(etag)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn etag_is_stable_and_sensitive() {\n        assert_eq!(etag_for(\"repos\", &[\"a\", \"b\"]), etag_for(\"repos\", &[\"a\", \"b\"]));\n        assert_ne!(etag_for(\"repos\", &[\"a\", \"b\"]), etag_for(\"repos\", &[\"a\", \"c\"]));\n        assert_ne!(etag_for(\"repos\", &[\"a\"]), etag_for(\"profile\", &[\"a\"]));\n    }\n\n    #[test]\n    fn constant_time_comparison() {\n        assert!(constant_time_eq(b\"secret\", b\"secret\"));\n        assert!(!constant_time_eq(b\"secret\", b\"secreT\"));\n        assert!(!constant_time_eq(b\"secret\", b\"secre\"));\n    }\n\n    #[test]\n    fn if_none_match_parsing() {\n        let mut headers = HeaderMap::new();\n        headers.insert(header::IF_NONE_MATCH, HeaderValue::from_static(\"\\\"x\\\", \\\"y\\\"\"));\n        assert!(matches_etag(&headers, \"\\\"y\\\"\"));\n        assert!(!matches_etag(&headers, \"\\\"z\\\"\"));\n        headers.insert(header::IF_NONE_MATCH, HeaderValue::from_static(\"*\"));\n        assert!(matches_etag(&headers, \"\\\"anything\\\"\"));\n        assert!(!matches_etag(&HeaderMap::new(), \"\\\"anything\\\"\"));\n    }\n}",
