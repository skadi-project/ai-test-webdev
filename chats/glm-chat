dius: 50%;\n  margin-right: 0.45em;\n  vertical-align: baseline;\n}\n.lang-bar-track {\n  height: 8px;\n  border-radius: 99px;\n  background: var(--skeleton);\n  overflow: hidden;\n}\n.lang-bar {\n  height: 100%;\n  border-radius: 99px;\n  transform-origin: left;\n  animation: grow 700ms cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n.lang-pct {\n  font-family: var(--font-mono);\n  color: var(--text-muted);\n  text-align: right;\n}\n\n@keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }\n\n/* Controls -------------------------------------------------------------------- */\n.controls {\n  display: grid;\n  grid-template-columns: 1.6fr 1fr 1fr 1fr;\n  gap: 0.75rem;\n  margin-bottom: 1.25rem;\n}\n\ninput[type=\"search\"], select {\n  width: 100%;\n  padding: 0.6rem 0.85rem;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n  font-size: 0.92rem;\n  transition: border-color var(--transition), box-shadow var(--transition);\n}\ninput[type=\"search\"]:hover, select:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }\ninput[type=\"search\"]:focus, select:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: var(--focus-ring);\n}\n\n/* Repo list --------------------------------------------------------------------- */\n.repo-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n  gap: 1rem;\n}\n\n.repo-card {\n  padding: 1.15rem 1.25rem 1.05rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.55rem;\n  position: relative;\n  overflow: hidden;\n  animation: rise 450ms cubic-bezier(0.22, 1, 0.36, 1) both;\n  transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);\n}\n.repo-card:hover {\n  transform: translateY(-3px);\n  border-color: color-mix(in srgb, var(--accent) 50%, var(--borde