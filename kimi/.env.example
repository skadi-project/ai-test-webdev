# Required: public GitHub profile used to build the portfolio.
GITHUB_USERNAME=octocat

# Optional: increases the GitHub API rate limit. Use a fine-grained token with public read access only.
GITHUB_TOKEN=

# Background refresh period and HTTP port.
REFRESH_INTERVAL_SECS=300
PORT=8080

# Required to enable POST /api/refresh. Send it in X-Admin-Token.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma-separated, case-insensitive repository names. Pinned repositories retain this order.
PINNED_REPOS=Hello-World,Spoon-Knife
EXCLUDED_REPOS=private-experiments,old-project

# Hidden by default.
SHOW_FORKS=false
SHOW_ARCHIVED=false

# Set to "none" to disable the on-disk cache. The directory is created automatically.
CACHE_PATH=data/cache.json

# Optional comma-separated CORS origins. Empty means same-origin only; * allows any origin.
CORS_ALLOW_ORIGINS=

# docker-compose only: host port mapped to container port 8080.
HOST_PORT=8080
