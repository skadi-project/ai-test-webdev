# Required: public GitHub user or organization
GITHUB_USERNAME=octocat
# Optional. Never sent to the browser; public API access needs no private repo scope.
GITHUB_TOKEN=
REFRESH_INTERVAL_SECS=300
PORT=8080
# Empty disables POST /api/refresh. Use a random 32+ character secret.
ADMIN_TOKEN=
# Comma separated names or owner/name, case insensitive. Pins keep this order.
PINNED_REPOS=Hello-World
EXCLUDED_REPOS=
SHOW_FORKS=false
SHOW_ARCHIVED=false
# Empty or 'none' disables disk persistence (Compose overrides with /data/cache.json).
CACHE_FILE=data/cache.json
# Maximum language requests per cycle; missing data is loaded incrementally.
LANGUAGE_BUDGET=40
GITHUB_API_BASE=https://api.github.com
# Same-origin by default. Optional exact origin (no wildcard).
CORS_ALLOW_ORIGIN=
RUST_LOG=github_portfolio=info,tower_http=info,warn
LOG_FORMAT=pretty
